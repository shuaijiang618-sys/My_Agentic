{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcm-diagnostics.local/contracts/rag_response.schema.json",
  "title": "TCM RAG Response",
  "description": "AI-Powered TCM Diagnostics RAG 问答响应契约（对齐 boundary-checklist.md §4 / project-blueprint.md §6）",
  "type": "object",
  "required": ["answer", "sources", "metadata"],
  "properties": {
    "answer": {
      "type": "string",
      "description": "模型生成的回答正文"
    },
    "sources": {
      "type": "array",
      "description": "检索证据引用列表",
      "items": {
        "type": "object",
        "required": ["snippet"],
        "properties": {
          "chunk_id": { "type": "string" },
          "snippet": { "type": "string", "maxLength": 500 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "doc_ref": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["model", "duration_ms", "release_id", "request_id"],
      "properties": {
        "model": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "release_id": { "type": "string" },
        "request_id": { "type": "string", "minLength": 8, "maxLength": 32 },
        "blocked": { "type": "boolean", "default": false },
        "blocked_reason": { "type": ["string", "null"] },
        "hitl_required": { "type": "boolean", "default": false },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
