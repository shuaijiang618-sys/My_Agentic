# 复制为 .env 再填入你自己的值:  cp .env.example .env
# (.env 不入库,见 .gitignore;本文件 .env.example 是模板,可入库)

# 必填: DeepSeek 官方 API Key —— https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 全项目统一模型（总管 + 8 专家 + 综合器）
MODEL=deepseek-v4-pro

# OpenAI 兼容端点（MAF OpenAIChatClient 通用）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 服务绑定（本地默认 127.0.0.1；容器/远程可改 0.0.0.0）
HOST=127.0.0.1

# 服务端口（默认 8093，与 flagship 8088 错开）
PORT=8093

# 注：DEEPSEEK_BASE_URL 可写 https://api.deepseek.com 或 https://api.deepseek.com/v1
# MAF OpenAIChatClient 会自动拼 /chat/completions

# Block 3B · 本地产业知识库(默认 true;初始化: python -m backend.seed.industry_kb)
ENABLE_INDUSTRY_KB=true

# Block 3C · 行情快照 akshare(默认 true;需 pip install akshare)
ENABLE_STOCK_SNAPSHOT=true

# Phase 3 · 质量与退避(M3.1)
ENABLE_FACT_CHECK=true
ENABLE_COMPLIANCE_FILTER=true
ENABLE_COMPLIANCE_RESCAN=true
ENABLE_PDF_EXPORT=true
ENABLE_OBSERVABILITY_LOG=true
LLM_RETRY_MAX=3
LLM_RETRY_BASE_SEC=1.0
