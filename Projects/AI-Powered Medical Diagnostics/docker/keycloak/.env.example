# Keycloak 本地联调 — 复制为 .env 后 merge 到项目根 .env
# 用法见 docker/keycloak/README.md

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=medical
KEYCLOAK_CLIENT_ID=medical-api

# ── 医疗 API 鉴权（Keycloak JWT）────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_JWT_ENABLED=true
# 仅 JWT 时可留空 AUTH_API_KEYS
AUTH_BIND_USER_ID=true
AUTH_DEFAULT_TENANT=hospital_a

AUTH_JWT_ISSUER=http://localhost:8080/realms/medical
AUTH_JWT_JWKS_URL=http://localhost:8080/realms/medical/protocol/openid-connect/certs
AUTH_JWT_ALGORITHMS=RS256
AUTH_JWT_AUDIENCE=medical-api
AUTH_JWT_TENANT_CLAIM=tenant_id
AUTH_JWT_ROLE_MAP=md-chat:chat,md-admin:admin,md-readonly:readonly

# Keycloak 测试账号（realm 导入）
# doctor / doctor123   → md-chat,  tenant hospital_a
# kbadmin / kbadmin123 → md-admin, tenant hospital_a
# viewer / viewer123   → md-readonly
