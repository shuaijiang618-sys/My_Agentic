# AI-Powered Medical Diagnostics — 二选一配置 LLM

# DeepSeek + Anthropic SDK（本项目统一用 anthropic.AsyncAnthropic）
DEEPSEEK_API_KEY=
# 推荐：https://api.deepseek.com/anthropic（也可写 https://api.deepseek.com，启动时会自动补 /anthropic）
# 勿写 …/v1 或 OpenAI 的 /v1/chat/completions 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-chat

# Anthropic 官方（与 DeepSeek 二选一）
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

ECHOMIND_SKILLS_DIR=./skills
ENABLE_OBSERVABILITY_LOG=true
# runs.jsonl 回复摘要最大长度（0=不写 response_preview）
# LOG_RESPONSE_PREVIEW_MAX=500

# ── 效果优先（效果 > 成本）推荐 ─────────────────────────────────────────────
# RAG_LITE 保持关闭（或不写），走 改写 + LLM 重排 全量 RAG
# RAG_PREFLIGHT_ENABLED=true          # 默认：低分才跳过 rewrite/rerank，高分仍全量
# OFF_TOPIC_LLM_ENABLED=true          # 偏题边界更准（+1 次 LLM）
# OFF_TOPIC_LLM_ALWAYS=false          # 有医疗关键词时不额外调 LLM
# LLM_TIMEOUT_S=90                    # 略增超时，减少大上下文超时失败
# LLM_MAX_RETRIES=2                   # 5xx/网络多试 1 次，提高成功率
# LLM_RETRY_ENABLED=true
# 知识库：./scripts/import_knowledge.sh（命中率 ↑）
# 可选更强模型：DEEPSEEK_MODEL=deepseek-chat 或 ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ── 省钱档（成本 > 效果）见 README：RAG_LITE=true ───────────────────────────

# OFF_TOPIC_LLM_ENABLED=false

# Prometheus（可选）：独立 metrics 端口；/metrics 始终在 PORT 上暴露
# PROMETHEUS_PORT=9091

# 外置 Prompt 目录（agents.yaml / rag / security/*.md）
# PROMPTS_DIR=./prompts

# RAG 预检（默认开）：向量 Top-1 未达 MIN_RETRIEVAL_SCORE 时跳过查询改写/重排 LLM
# RAG_PREFLIGHT_ENABLED=true

# RAG 省 Token 模式：仅向量检索，跳过查询改写与 LLM 重排（预检自动让位）
# RAG_LITE=true

# LLM 超时与重试（create_message 统一入口）
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=1
# LLM_RETRY_ENABLED=true
# LLM_RETRY_BACKOFF_S=0.5

# Agent 空内容拒答（正文少于该字符数）
# MIN_AGENT_RESPONSE_CHARS=8

# 偏题 LLM 分类（regex 通过后，对无医疗关键词的问题）
# OFF_TOPIC_LLM_ENABLED=false
# OFF_TOPIC_LLM_ALWAYS=false

# 内容安全 API（可选，JSON: {"text","direction"} → {"safe":bool} 或 {"unsafe":bool}）
# CONTENT_SAFETY_API_URL=
# CONTENT_SAFETY_API_KEY=
# CONTENT_SAFETY_API_TIMEOUT_S=5

# Slack 告警（可选）：Alertmanager Incoming Webhook，勿提交到 Git
# 创建方式：Slack App → Incoming Webhooks → 选择频道 → 复制 URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# SLACK_CHANNEL=#medical-alerts

# ── API 鉴权（内测/生产）────────────────────────────────────────────────────
# AUTH_ENABLED=false                 # 默认：POC 模式，不要求 Token（与现网 curl 兼容）
# AUTH_DEFAULT_TENANT=default        # admin 通配 * 时的默认写入租户
# AUTH_BIND_USER_ID=true             # Key 绑定 user_id 时拒绝客户端伪造
# AUTH_PUBLIC_PATHS=                 # 额外公开路径（逗号分隔），默认含 /health /metrics /docs
#
# Key 格式：secret:role:tenant[:user_id]  角色 chat | readonly | admin
# AUTH_API_KEYS=chat-key-a:chat:hospital_a,chat-u1:chat:hospital_a:u1,admin-key:admin:*
#
# 调用示例：
# curl -H "Authorization: Bearer chat-key-a" -H "Content-Type: application/json" \
#   -d '{"message":"你好","user_id":"u1"}' http://127.0.0.1:8010/chat
# admin 写入知识库（可 X-Tenant-ID 指定租户）：
# curl -H "Authorization: Bearer admin-key" -H "X-Tenant-ID: hospital_a" \
#   -X POST http://127.0.0.1:8010/knowledge/add -H "Content-Type: application/json" \
#   -d '{"documents":[{"title":"test","content":"..."}]}'
#
# ── JWT / OIDC（与 API Key 并存）────────────────────────────────────────────
# AUTH_JWT_ENABLED=true
# AUTH_JWT_SECRET=change-me-in-production          # HS256 内测/对称密钥
# AUTH_JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json  # OIDC RS256
# AUTH_JWT_ISSUER=https://idp.example.com
# AUTH_JWT_AUDIENCE=medical-diagnostics-api
# AUTH_JWT_ALGORITHMS=HS256                        # 或 RS256,ES256
# AUTH_JWT_TENANT_CLAIM=tenant_id                  # 缺省 AUTH_DEFAULT_TENANT
# AUTH_JWT_ROLES_CLAIM=roles                       # 或 Keycloak realm_access.roles
# AUTH_JWT_ROLE_MAP=admin:admin,viewer:readonly,doctor:chat
#
# 内测签发 JWT：
# python scripts/gen_test_jwt.py --sub u1 --tenant hospital_a --roles chat --print-curl
#
# 带鉴权 API 导入知识库：
# MEDICAL_API_KEY=admin-key ./scripts/import_knowledge.sh --via-api http://127.0.0.1:8010
# ./scripts/import_knowledge.sh --via-api http://127.0.0.1:8010 --api-key admin-key --tenant-id hospital_a
#
# ── Keycloak 本地 OIDC 联调 ─────────────────────────────────────────────────
# ./scripts/keycloak_up.sh              # Docker 启动 Keycloak :8080
# cat docker/keycloak/.env.example >> .env && ./scripts/start.sh
# ./scripts/keycloak_smoke.sh           # Token + /chat 端到端
# ./scripts/backfill_kb_tenant_shared.sh --tenant hospital_a  # 旧库 tenant 回填 + ALT 导入
# 详见 docker/keycloak/README.md
