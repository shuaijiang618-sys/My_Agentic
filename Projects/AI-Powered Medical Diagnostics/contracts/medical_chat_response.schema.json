{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-Powered Medical Diagnostics ChatResponse",
  "type": "object",
  "required": [
    "conv_id", "response", "intent", "agent_type",
    "escalated", "emergency", "blocked", "disclaimer", "request_id"
  ],
  "properties": {
    "conv_id": { "type": "string" },
    "response": { "type": "string" },
    "intent": { "type": "string" },
    "agent_type": { "type": "string" },
    "escalated": { "type": "boolean" },
    "emergency": { "type": "boolean" },
    "blocked": { "type": "boolean" },
    "hitl_required": { "type": "boolean" },
    "safety_passed": { "type": "boolean" },
    "disclaimer": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "doc_type": { "type": "string" },
          "source": { "type": "string" },
          "score": { "type": "number" }
        }
      }
    },
    "knowledge_used": { "type": "boolean" },
    "latency_ms": { "type": "number" },
    "request_id": { "type": "string" }
  }
}
