# 开发时 Vite 代理目标（也可直接写完整 API 地址到 VITE_API_URL）
VITE_API_URL=http://127.0.0.1:8010

# AUTH_ENABLED=true 时可在构建/开发环境预填 Token（也可在 UI 粘贴）
# VITE_AUTH_TOKEN=
# VITE_TENANT_ID=hospital_a

# Keycloak（UI「获取 JWT」默认值）
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=medical
# VITE_KEYCLOAK_CLIENT_ID=medical-api
